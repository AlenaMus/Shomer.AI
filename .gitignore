# Audit DB (created at runtime by audit_log module)
server/audit.db
server/audit.db-journal
server/audit.db-wal
server/audit.db-shm
# SqliteAuditStore default lives under server/data/ (AUDIT_DB_PATH); runtime-only
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
# Generated load-test report
docs/loadtest_report.md

# Reports (load_test, eval, etc. — generated outputs)
reports/

# Intermediate HTML artifacts from scripts/md_to_pdf.py (kept next to .md siblings)
docs/**/*.html
plan-docs/**/*.html

# Claude Code per-machine state (settings, agent transcripts)
.claude/

# DictaBERT / model checkpoints under server/models/ (downloaded weights)
server/models/

# Local config / API keys
server/.env

# OCR validation — large/intermediate artifacts (regenerable from sentences.jsonl)
data/ocr_validation/images/
data/ocr_validation/_*.txt
data/ocr_validation/_*.log
data/ocr_validation/_*.md

# Local-only working folders — not for the canonical repo
bp_latex/
android_integration_res/

# Test-console session artifacts (audit.db + server.log per run)
test-sessions/

# Local-only gap analysis (not for the canonical repo)
gaps.md
.claude/gaps.md

# Gmail OAuth secrets — never commit
gmail_credentials/
*token.json
