# Shomer.AI — server environment template
# Copy this file to `server/.env` (gitignored) and fill in your values.
#
# Source of record for every key: docs/design/<module>/design.md §9.

# -----------------------------------------------------------------------------
# Classifier (TextClassifier Protocol — adapter selection)
# v1.0-standin = OllamaDictaBertClassifier (Qwen via Ollama, current default)
# v1.1-dictabert = HuggingFaceClassifier (DictaBERT base, requires HF download)
# -----------------------------------------------------------------------------
CLASSIFIER_MODEL_VERSION=v1.0-standin
DICTABERT_MODEL_PATH=server/models/dictabert-offensive
DICTABERT_HF_NAME=dicta-il/dictabert
CLASSIFIER_TIMEOUT_S=60.0
BORDERLINE_LOW=0.3
BORDERLINE_HIGH=0.7
CALIBRATION_METHOD=none
CALIBRATION_PKL_PATH=server/models/calibrator.pkl

# Ollama stand-in (used by the v1.0 adapter)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=offensive-hebrew:v1
# Legacy var name still read by main.py — keep until full lifespan refactor lands.
MODEL_NAME=offensive-hebrew:v1
VISION_MODEL_NAME=qwen2.5vl:7b
REQUEST_TIMEOUT_S=60
VISION_TIMEOUT_S=180
# Legacy image-strategy router (ocr_only | vision_only | pipeline | parallel | stub)
IMAGE_STRATEGY=pipeline

# -----------------------------------------------------------------------------
# OCR (OcrBackend Protocol)
# -----------------------------------------------------------------------------
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_BACKEND=tesseract
OCR_LANG=heb+eng
OCR_MAX_IMAGE_MB=10
OCR_TIMEOUT_S=180

# -----------------------------------------------------------------------------
# Audit Log (AuditStore Protocol)
# -----------------------------------------------------------------------------
AUDIT_DB_PATH=./audit.db
AUDIT_RETENTION_DAYS=7
AUDIT_RETENTION_SWEEP_INTERVAL_HOURS=1
AUDIT_MAX_DB_SIZE_MB=500
AUDIT_VACUUM_ON_RETENTION=true

# -----------------------------------------------------------------------------
# Context Agent (ContextReasoner / LlmClient / TokenBudgetGuard)
# Adapter selection. "mock" requires no keys.
# -----------------------------------------------------------------------------
CONTEXT_AGENT_ENABLED=true
CONTEXT_AGENT_PRIMARY_LLM=gpt-4o-mini
CONTEXT_AGENT_FALLBACK_LLM=haiku-4.5
CONTEXT_AGENT_TIMEOUT_S=5
CONTEXT_AGENT_HISTORY_TURNS=5
CONTEXT_AGENT_DAILY_USD_BUDGET=5.0
CONTEXT_AGENT_DAILY_TOKEN_BUDGET=500000

# LLM API keys — FILL THESE IN; never commit to git (server/.env is gitignored).
# Priority when multiple are set: GEMINI (primary) > OPENAI > ANTHROPIC; the
# next-configured key becomes the fallback, Mock fills any empty slot.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gemini uses its OpenAI-compatible endpoint (reuses the openai SDK).
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Triage (rule-based, deterministic — no LLM)
# -----------------------------------------------------------------------------
TRIAGE_BASELINE_THRESHOLD=0.5
TRIAGE_ALWAYS_ESCALATE_LABELS=violence
TRIAGE_ALWAYS_ALERT_LABELS=pornographic

# -----------------------------------------------------------------------------
# Alerts (FCM)
# -----------------------------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=
ALERTS_MAX_PER_MINUTE=10
ALERTS_RETRY_MAX=3

# -----------------------------------------------------------------------------
# Server / Gatekeeper
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PORT=8000
GATEWAY_RATE_LIMIT_PER_MIN=100
GATEWAY_MAX_REQUEST_MB=10
GATEWAY_TEXT_TIMEOUT_S=60
GATEWAY_IMAGE_TIMEOUT_S=180

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
