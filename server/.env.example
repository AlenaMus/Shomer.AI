OLLAMA_URL=http://localhost:11434
MODEL_NAME=offensive-hebrew:v1
VISION_MODEL_NAME=qwen2.5vl:7b
PORT=8000
REQUEST_TIMEOUT_S=60
# Vision LLM is several times slower than text — give it more headroom.
VISION_TIMEOUT_S=180
# Image-processing strategy: ocr_only | vision_only | pipeline | parallel | stub
# pipeline = OCR first, fall back to vision if no text extracted (default; good for mixed inputs).
IMAGE_STRATEGY=pipeline
# Absolute path to tesseract.exe on Windows. Linux/macOS users can comment this out
# and rely on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
